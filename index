label, account or party, division or remarks, amount, optional IN LACS. Subtotal and total rows are checked, never added twice. Amounts such as &#8377;4,96,700 or (1,25,000) are read correctly. The last report you updated is remembered in this browser.<\/p>\n    <\/div>\n  <\/section>\n\n  <main class=\"sheet\" id=\"sheet\">\n    <div class=\"ribbon\" id=\"ribbon\" hidden>SAMPLE DATA - NOT REAL<\/div>\n    <header class=\"hd\">\n      <div class=\"hd-in\">\n        <div class=\"logo\"><img alt=\"SEAPOL\" src=\"data:image/png;base64,\"><\/div>\n        <div>\n          <div class=\"co\">SEAPORT LINES INDIA PVT LTD &nbsp;|&nbsp; <b>AIR DIVISION<\/b><\/div>\n          <h1>DAILY FINANCIAL <span>REPORT<\/span><\/h1>\n          <div class=\"sub\">CASH FLOW &amp; WORKING CAPITAL SUMMARY<\/div>\n        <\/div>\n        <div class=\"dt\"><small>REPORT DATE<\/small><b id=\"rdate\">--<\/b><\/div>\n      <\/div>\n    <\/header>\n    <section class=\"kpis\" id=\"kpis\" aria-label=\"Key figures\"><\/section>\n    <div class=\"body\">\n      <div class=\"row r1\">\n        <section class=\"card\" id=\"cBank\"><\/section>\n      <\/div>\n      <div class=\"row r2\">\n        <section class=\"card deb\" id=\"cDeb\"><\/section>\n        <section class=\"card cred\" id=\"cCred\"><\/section>\n      <\/div>\n      <div class=\"row r3\">\n        <section class=\"card alerts\" id=\"cAlerts\"><\/section>\n        <section class=\"card chart\" id=\"cBridge\"><\/section>\n      <\/div>\n      <div class=\"row r4\">\n        <section class=\"card cash\" id=\"cCash\"><\/section>\n        <section class=\"card rec\" id=\"cRec\"><\/section>\n        <section class=\"card liab\" id=\"cLiab\"><\/section>\n      <\/div>\n      <div class=\"net\" id=\"net\"><\/div>\n      <div class=\"foot\"><span id=\"fsrc\"><\/span><span class=\"ck\" id=\"fck\"><\/span><span id=\"fgen\"><\/span><\/div>\n    <\/div>\n  <\/main>\n<\/div>\n<script type=\"application/json\" id=\"seed\"><\/script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js\"><\/script>\n<script>\n(function () {\n  \"use strict\";\n  var $ = function (id) { return document.getElementById(id); };\n  var esc = function (s) { return String(s == null ? \"\" : s).replace(/[&<>\"]/g, function (c) { return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c]; }); };\n  var RS = \"\u20b9\";\n\n  /* ---------- Indian rupee / lakh formatting ---------- */\n  function grp(intStr) { var l = intStr.slice(-3), r = intStr.slice(0, -3); return r ? r.replace(/\\B(?=(\\d{2})+(?!\\d))/g, \",\") + \",\" + l : l; }\n  function round2(n) { return Math.round((n + (n < 0 ? -1e-9 : 1e-9)) * 100) / 100; }\n  function inr(n) {\n    n = round2(n); var neg = n < 0, a = Math.abs(n), whole = Math.floor(a), p = Math.round((a - whole) * 100);\n    if (p === 100) { whole += 1; p = 0; }\n    return (neg ? \"-\" : \"\") + RS + grp(String(whole)) + (p ? \".\" + (\"0\" + p).slice(-2) : \"\");\n  }\n  function lac(n) { var v = round2(n) / 1e5; var s = Math.abs(v).toFixed(2); return (v < 0 && Number(s) !== 0 ? \"-\" : \"\") + s + \" L\"; }\n  function cr(n) { var v = n / 1e7; var s = Math.abs(v).toFixed(2); return (v < 0 && Number(s) !== 0 ? \"-\" : \"\") + s + \" CR\"; }\n  function pctOf(a, b) { return b > 0 ? (a / b * 100).toFixed(1) + \"%\" : \"0.0%\"; }\n\n  /* ---------- reading cells ---------- */\n  function classify(raw) {\n    var s = String(raw == null ? \"\" : raw).replace(/\u00a0/g, \" \").trim();\n    if (!s) return { t: \"empty\", raw: \"\" };\n    if (/^[-\u2013\u2014]$/.test(s)) return { t: \"amt\", v: 0, raw: s };\n    if (/^\\(?-?\\s*(\u20b9|Rs\\.?|INR)?\\s*-?[\\d,]*\\.?\\d+\\s*(L|Lac|Lacs|Lakh|Lakhs)\\)?$/i.test(s)) return { t: \"lacs\", raw: s };\n    var m = s.match(/^(\\()?\\s*(-)?\\s*(\u20b9|Rs\\.?|INR)?\\s*(-)?\\s*([\\d,]+(?:\\.\\d+)?)\\s*(\\))?$/i);\n    if (m && /\\d/.test(m[5]) && !!m[1] === !!m[6]) {\n      var digits = m[5].replace(/[^\\d]/g, \"\").length, hasSym = !!m[3] || m[5].indexOf(\",\") >= 0;\n      if (digits > 11 && !hasSym) return { t: \"acct\", raw: s };\n      var v = parseFloat(m[5].replace(/,/g, \"\"));\n      if (m[1] || m[2] || m[4]) v = -v;\n      return { t: \"amt\", v: v, raw: s };\n    }\n    return { t: \"text\", raw: s };\n  }\n  function parseDate(s) {\n    var m = String(s || \"\").match(/(\\d{1,2})[-\\/.](\\d{1,2})[-\\/.](\\d{4})/);\n    if (!m) return null;\n    var d = +m[1], mo = +m[2], y = +m[3];\n    if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;\n    return (\"0\" + d).slice(-2) + \"-\" + (\"0\" + mo).slice(-2) + \"-\" + y;\n  }\n\n  /* ---------- parser: whole pasted report block ---------- */\n  function parseReport(text) {\n    var model = { date: null, bank: [], deb: [], cred: [], decl: {}, subs: { deb: [], cred: [] } };\n    var issues = [], sec = null, lastCat = \"\", seenSec = {};\n    model.date = parseDate((text.match(/report\\s*date[^\\d]*(\\d{1,2}[-\\/.]\\d{1,2}[-\\/.]\\d{4})/i) || [])[1]) || parseDate(text);\n    text.split(/\\r?\\n/).forEach(function (line, ln) {\n      if (!line.replace(/\\s/g, \"\")) return;\n      var cells = (line.indexOf(\"\\t\") >= 0 ? line.split(\"\\t\") : line.split(/\\s{3,}/)).map(function (c) { return c.trim(); });\n      var tok = cells.map(classify);\n      var first = (cells.filter(function (c) { return c !== \"\"; })[0] || \"\").replace(/^[^A-Za-z0-9]+/, \"\");\n      var nonEmpty = cells.filter(function (c) { return c !== \"\"; }).length;\n      /* section headings: a line with just a title */\n      if (nonEmpty === 1) {\n        if (/^bank\\s*balance$/i.test(first)) { sec = \"bank\"; seenSec.bank = 1; return; }\n        if (/^debtors$/i.test(first)) { sec = \"deb\"; seenSec.deb = 1; return; }\n        if (/^creditors$/i.test(first)) { sec = \"cred\"; seenSec.cred = 1; return; }\n      }\n      if (/^net\\s+(increase|decrease|position)/i.test(first)) { sec = \"net\"; }\n      /* column headers */\n      if (/^(bank|category)$/i.test(first) && !tok.some(function (t) { return t.t === \"amt\"; })) return;\n      if (!sec) return;\n      /* amount: right-most amount cell (account numbers and lakh cells are not amounts) */\n      var ai = -1, i;\n      for (i = tok.length - 1; i >= 0; i--) { if (tok[i].t === \"amt\") { ai = i; break; } }\n      var amt = ai >= 0 ? tok[ai].v : null;\n      var label = \"\", extras = [];\n      for (i = 0; i < cells.length; i++) {\n        if (i === ai || tok[i].t === \"lacs\" || tok[i].t === \"empty\") continue;\n        if (i === 0) label = cells[i]; else extras.push(cells[i]);\n      }\n      var lbl = label.replace(/^[^A-Za-z0-9(]+/, \"\");\n      if (sec === \"net\") { if (amt != null) model.decl.net = amt; return; }\n      if (/^total\\s+bank\\s+balance/i.test(lbl)) { if (amt != null) model.decl.bank = amt; return; }\n      if (/^free\\s+balance/i.test(lbl)) { if (amt != null) model.decl.free = amt; return; }\n      if (/^total\\s+debtors/i.test(lbl)) { if (amt != null) model.decl.deb = amt; return; }\n      if (/^total\\s+creditors/i.test(lbl)) { if (amt != null) model.decl.cred = amt; return; }\n      if (sec === \"bank\") {\n        if (!lbl && !extras.length) return;\n        if (amt == null) { issues.push({ l: \"warn\", m: \"Line \" + (ln + 1) + \": bank row \\\"\" + lbl + \"\\\" has no amount, counted as \" + RS + \"0.\" }); amt = 0; }\n        model.bank.push({ name: lbl, acc: extras[0] || \"\", div: extras[1] || \"\", amt: amt, lien: /lien/i.test(lbl) });\n        return;\n      }\n      /* debtors / creditors */\n      if (!lbl && !extras.length) { if (amt != null) model.subs[sec].push(amt); return; }   // unlabeled subtotal row\n      if (amt == null) { issues.push({ l: \"warn\", m: \"Line \" + (ln + 1) + \": row \\\"\" + (lbl || extras[0]) + \"\\\" has no amount, counted as \" + RS + \"0.\" }); amt = 0; }\n      var cat = lbl || lastCat;\n      if (lbl) lastCat = lbl;\n      model[sec].push({ cat: cat, rep: !lbl, party: extras[0] || \"\", rem: extras[1] || \"\", amt: amt });\n    });\n    if (!seenSec.bank && !seenSec.deb && !seenSec.cred) {\n      issues.push({ l: \"err\", m: \"No sections found. Copy the report including the titles BANK BALANCE, DEBTORS and CREDITORS, then paste again.\" });\n    } else {\n      if (!seenSec.bank) issues.push({ l: \"warn\", m: \"BANK BALANCE section not found; bank figures are \" + RS + \"0.\" });\n      if (!seenSec.deb) issues.push({ l: \"warn\", m: \"DEBTORS section not found; debtors are \" + RS + \"0.\" });\n      if (!seenSec.cred) issues.push({ l: \"warn\", m: \"CREDITORS section not found; creditors are \" + RS + \"0.\" });\n    }\n    return { model: model, issues: issues };\n  }\n\n  /* ---------- calculations (always from the source rows) ---------- */\n  function compute(m) {\n    var sum = function (a, f) { return round2(a.reduce(function (s, r) { return s + (f ? f(r) : r.amt); }, 0)); };\n    var c = {};\n    c.bank = sum(m.bank);\n    c.lien = sum(m.bank.filter(function (r) { return r.lien; }));\n    c.free = round2(c.bank - c.lien);\n    c.deb = sum(m.deb); c.cred = sum(m.cred);\n    c.net = round2(c.free + c.deb - c.cred);\n    return c;\n  }\n  function checks(m, c) {\n    var out = [], tol = 0.5;\n    var cmp = function (declared, calc, name) {\n      if (declared == null) return;\n      if (Math.abs(declared - calc) > tol) out.push({ l: \"warn\", m: name + \" in the pasted data is \" + inr(declared) + \" but its rows add up to \" + inr(calc) + \". The report uses the rows; please check the sheet.\" });\n    };\n    cmp(m.decl.bank, c.bank, \"Total Bank Balance\");\n    cmp(m.decl.free, c.free, \"Free Balance\");\n    cmp(m.decl.deb, c.deb, \"Total Debtors\");\n    cmp(m.decl.cred, c.cred, \"Total Creditors\");\n    cmp(m.decl.net, c.net, \"Net position\");\n    [\"deb\", \"cred\"].forEach(function (k) {\n      (m.subs[k] || []).forEach(function (s) {\n        if (Math.abs(s - c[k]) > tol) out.push({ l: \"warn\", m: \"A \" + (k === \"deb\" ? \"debtors\" : \"creditors\") + \" subtotal row shows \" + inr(s) + \" but the rows add up to \" + inr(c[k]) + \".\" });\n      });\n    });\n    var neg = m.bank.concat(m.deb, m.cred).filter(function (r) { return r.amt < 0; });\n    if (neg.length) out.push({ l: \"warn\", m: neg.length + \" row(s) have negative amounts (\" + neg.slice(0, 3).map(function (r) { return r.name || r.cat; }).join(\", \") + \"). Shown in red, not changed.\" });\n    if (c.lien > c.bank + 0.5) out.push({ l: \"warn\", m: \"Lien amount \" + inr(c.lien) + \" is more than total bank balance \" + inr(c.bank) + \".\" });\n    return out;\n  }\n  function alerts(m, c) {\n    var a = [];\n    if (c.bank > 0 && c.lien >= c.bank - 0.5) a.push({ l: \"crit\", m: \"Entire bank balance of \" + inr(c.bank) + \" is under lien. No free cash available.\" });\n    else if (c.bank > 0 && c.lien / c.bank >= 0.5) a.push({ l: \"warn\", m: \"Lien is \" + pctOf(c.lien, c.bank) + \" of the bank balance (\" + inr(c.lien) + \" of \" + inr(c.bank) + \").\" });\n    if (c.free <= 0 && c.cred > 0) a.push({ l: \"crit\", m: \"No free bank balance against creditors of \" + inr(c.cred) + \".\" });\n    else if (c.free <= 0 && c.bank >= 0 && !(c.bank > 0 && c.lien >= c.bank - 0.5)) a.push({ l: \"warn\", m: \"Free bank balance is \" + inr(c.free) + \".\" });\n    if (c.net < 0) a.push({ l: \"crit\", m: \"Net financial position is negative: \" + inr(c.net) + \" (\" + lac(c.net) + \"). Creditors exceed free bank plus debtors.\" });\n    else if (c.cred > 0 && c.free + c.deb < c.cred * 1.1) a.push({ l: \"warn\", m: \"Free bank plus debtors covers creditors by only \" + ((c.free + c.deb) / c.cred).toFixed(2) + \"x.\" });\n    if (c.deb > 0 && c.cred > 0 && c.deb < c.cred) a.push({ l: \"info\", m: \"Debtors (\" + inr(c.deb) + \") are lower than creditors (\" + inr(c.cred) + \").\" });\n    if (!a.length) a.push({ l: \"ok\", m: c.bank === 0 && c.deb === 0 && c.cred === 0 ? \"All figures are \" + RS + \"0 for this date.\" : \"No risk alerts for