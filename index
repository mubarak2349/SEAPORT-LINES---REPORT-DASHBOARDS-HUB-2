function fit(f){try{var d=f.contentDocument;if(!d||!d.documentElement)return;var h=Math.max(d.documentElement.scrollHeight,d.body?d.body.scrollHeight:0);if(h&&Math.abs(f.offsetHeight-h)>2)f.style.height=h+"px";}catch(e){}}
function show(k){
  if(!PAGES[k])k="daily";
  Object.keys(PAGES).forEach(function(n){
    var f=document.getElementById("f-"+n),t=document.getElementById("t-"+n),on=n===k;
    f.classList.toggle("on",on);if(t)t.setAttribute("aria-selected",on?"true":"false");
    var mi=document.querySelector('.pop [data-k="'+n+'"]');if(mi){if(on)mi.setAttribute("aria-current","true");else mi.removeAttribute("aria-current");}
  });
  curK=k;say("");var tn=/^(daily|monthly|yearly)$/.test(k);document.getElementById("t-tonnage").setAttribute("aria-selected",tn?"true":"false");if(tn)document.getElementById("tl").textContent=k.charAt(0).toUpperCase()+k.slice(1);closeMenu();
  var f=document.getElementById("f-"+k);
  if(!loaded[k]){loaded[k]=1;f.addEventListener("load",function(){fit(f);});f.srcdoc=PAGES[k];}
  clearInterval(timers.x);timers.x=setInterval(function(){fit(f);},500);
  try{history.replaceState(null,"","#"+k);}catch(e){}
  window.scrollTo(0,0);
}
var mb=document.getElementById("t-tonnage"),pop=document.getElementById("pop");
function closeMenu(){pop.hidden=true;mb.setAttribute("aria-expanded","false")}
mb.addEventListener("click",function(e){e.stopPropagation();var o=pop.hidden;pop.hidden=!o;mb.setAttribute("aria-expanded",o?"true":"false");if(o){var c=pop.querySelector("[aria-current=true]")||pop.querySelector("button");c.focus()}});
document.addEventListener("click",function(e){if(!pop.contains(e.target))closeMenu()});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&!pop.hidden){closeMenu();mb.focus()}});
Array.prototype.forEach.call(document.querySelectorAll(".tabs button[data-k]"),function(b){b.addEventListener("click",function(){show(b.dataset.k);});});
function image(share){
  var f=document.getElementById("f-"+curK),d;
  try{d=f.contentDocument;}catch(e){}
  if(!d||!d.body||!d.body.children.length){say("Page is still loading, try again in a moment.");return;}
  if(curK==="financial"||curK==="fnpay"||curK==="ageing"){var b=d.getElementById(share?"share":"png");if(b)b.click();say("Creating the financial report image. Needs internet the first time.");return;}
  var cv=d.getElementById("cv");if(!cv){say("Poster not found.");return;}
  var dt=((d.getElementById("date")||{}).value||"report").replace(/[^0-9A-Za-z-]/g,"-");
  var name=curK.charAt(0).toUpperCase()+curK.slice(1)+"_Tonnage_Report_"+dt+".png";
  cv.toBlob(function(blob){
    if(!blob){say("Could not create the image. Try again.");return;}
    var file=new File([blob],name,{type:"image/png"});
    if(share&&navigator.canShare&&navigator.canShare({files:[file]})){
      navigator.share({files:[file],title:name}).then(function(){say("Shared.");},function(){say("Share cancelled. Use DOWNLOAD IMAGE to save it.");});return;
    }
    var a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();
    setTimeout(function(){URL.revokeObjectURL(a.href);},3000);
    say("Saved "+name+(share?". This browser cannot open WhatsApp directly, so attach the saved image in WhatsApp.":". Ready to send on WhatsApp."));
  },"image/png");
}
document.getElementById("dlimg").addEventListener("click",function(){image(false);});
document.getElementById("shimg").addEventListener("click",function(){image(true);});
show((location.hash||"").replace("#","")||"daily");
})();
</script></body></html>
