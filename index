und(heroImg.height * W / heroImg.width);\n      var oc = document.createElement(\"canvas\"); oc.width = W; oc.height = hh;\n      var o = oc.getContext(\"2d\");\n      o.filter = \"blur(0.9px)\"; o.drawImage(heroImg, 0, 0, W, hh); o.filter = \"none\";\n      o.globalCompositeOperation = \"destination-in\";\n      var m = o.createLinearGradient(0, 0, 0, hh), k;\n      for (k = 0; k <= 10; k++) { var t = k / 10, y = t * 200; m.addColorStop(Math.min(1, y / hh), \"rgba(0,0,0,\" + Math.pow(t, 1.3) + \")\"); }\n      for (k = 0; k <= 10; k++) { var t2 = k / 10, y2 = hh - 230 + t2 * 230; m.addColorStop(Math.min(1, y2 / hh), \"rgba(0,0,0,\" + Math.pow(1 - t2, 1.2) + \")\"); }\n      o.fillStyle = m; o.fillRect(0, 0, W, hh);\n      ctx.drawImage(oc, 0, 290);\n    }\n    var gl = ctx.createRadialGradient(180, 0, 0, 180, 0, 420);\n    gl.addColorStop(0, \"rgba(255,122,24,0.20)\"); gl.addColorStop(1, \"rgba(255,122,24,0)\");\n    ctx.fillStyle = gl; ctx.fillRect(0, 0, W, 520);\n  }\n\n  /* ---------- the poster ---------- */\n  function render(items, date) {\n    var total = items.reduce(function (s, i) { return s + i.w; }, 0);\n    var polTot = {}, custTot = {}, custPol = {};\n    items.forEach(function (i) {\n      polTot[i.p] = (polTot[i.p] || 0) + i.w; custTot[i.c] = (custTot[i.c] || 0) + i.w;\n      if (!custPol[i.c] || i.w > custPol[i.c].w) custPol[i.c] = { p: i.p, w: i.w };\n    });\n    var ports = Object.keys(polTot).map(function (k) { return [k, polTot[k]]; }).sort(function (a, b) { return b[1] - a[1]; });\n    var custs = Object.keys(custTot).map(function (k) { return [k, custTot[k]]; }).sort(function (a, b) { return b[1] - a[1]; });\n    var rank = {}; custs.forEach(function (c, i) { rank[c[0]] = i; });\n    var rows = items.slice().sort(function (a, b) { return rank[a.c] - rank[b.c] || b.w - a.w; });\n    var pct = function (v) { return (v / total * 100).toFixed(1) + \"%\"; };\n\n    var KY = 845, KH = 104, DY = KY + KH + 22, HR = 46, TR = 56, LX = 30, LW = 640;\n 